<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.benshi"
version="0.0.1"
name="Benshi.fr"
provider-name="Norton-breman">
<requires>
  <import addon="xbmc.python" version="3.0.1"/>
  <import addon="inputstream.adaptive" optional="true"/>
</requires>
<extension point="xbmc.python.pluginsource" library="main.py">
  <provides>video</provides>
</extension>
<extension point="xbmc.addon.metadata">
  <summary lang="fr_FR">Addon pour benshi.fr</summary>
  <description lang="fr_FR">Plugin pour regarder des vidéos depuis benshi.fr.</description>
  <disclaimer lang="fr_FR">Nécéssite un compte et un abonnement</disclaimer>
  <license>GPL-3.0-only	</license>
  <assets>
    <icon>resources/images/icon.png</icon>
    <fanart>resources/images/fanart.jpg</fanart>
    <screenshot>resources/images/screenshot-1.jpg</screenshot>
    <screenshot>resources/images/screenshot-2.jpg</screenshot>
  </assets>
  <news>Updated with latest artwork metadata</news>
</extension>
</addon>
